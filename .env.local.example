# Supabase project settings — Project Settings > API in the Supabase dashboard.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only, never prefix with NEXT_PUBLIC_. Used only by
# lib/supabase/admin.ts to invite users by email from the Users page.
# Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) — sends the weekly automatic backup email.
# Get a free API key from the Resend dashboard.
RESEND_API_KEY=your-resend-api-key

# Where the weekly backup email gets sent.
BACKUP_EMAIL_TO=you@example.com

# Random secret that proves a request to /api/cron/* really came from
# Vercel's scheduler, not a random visitor. Any long random string works.
CRON_SECRET=generate-a-long-random-string
